# Production settings for Render. Secrets are intentionally blank: set them in the Render dashboard (render.yaml generates most).
# DATABASE_URL is injected by Render from mylapore-db.
# ---- Core ----
NODE_ENV=production
PORT=4000
DATABASE_URL=
FRONTEND_URL=https://mylapore-web.onrender.com
CORS_ORIGINS=https://mylapore-web.onrender.com

# ---- Business config (ALL PLACEHOLDERS: confirm with management) ----
TAX_PERCENT=0
DELIVERY_FEE_PAISE=0
# Comma-separated pincodes served for home delivery. Empty = delivery disabled.
SERVICE_PINCODES=517501,517502,517503
COD_ENABLED=true
PAYMENT_PENDING_EXPIRY_MINUTES=30

# ---- Staff access (MVP). Replace with JWT/RBAC in Phase 2 ----
STAFF_API_KEY=

# ---- Payments ----
# mock | razorpay
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Hosts the checkout URL is allowed to point at (the frontend host is always trusted in mock mode)
TRUSTED_CHECKOUT_HOSTS=rzp.io,razorpay.com

# ---- Salesforce (optional; sync is skipped when unset) ----
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=3MVG9HtWXcDGV.nFvKRjmmuFOHC3oW5bdP5UrIIFXo.o2tCQvC9vwBZ1JBB4smXnvg2Ap5V8V6e.vCiXIK3vd
SALESFORCE_CLIENT_SECRET=0D9203F531B4D5BE8BE0A9764AE0260B9E6F622B5C902516B1F1434991754F69
SALESFORCE_ORDER_OBJECT=Web_Order__c
SALESFORCE_INBOUND_KEY=
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=8

JWT_SECRET=
GOOGLE_CLIENT_ID=

# Salesforce/Agentforce API key (sent by Salesforce in the x-api-key header)
AGENT_API_KEY=
# Public base URL used for absolute image links returned to Salesforce (set to the public HTTPS site/CDN)
PUBLIC_ASSET_URL=https://mylapore-web.onrender.com
