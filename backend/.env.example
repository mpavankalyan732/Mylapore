# ---- Core ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vegrestaurant
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Business config (ALL PLACEHOLDERS: confirm with management) ----
TAX_PERCENT=0
DELIVERY_FEE_PAISE=0
# Comma-separated pincodes served for home delivery. Empty = delivery disabled.
SERVICE_PINCODES=517501,517502,517503
COD_ENABLED=true
PAYMENT_PENDING_EXPIRY_MINUTES=30

# ---- Staff access (MVP). Replace with JWT/RBAC in Phase 2 ----
STAFF_API_KEY=change-me-staff-key

# ---- Payments ----
# mock | razorpay
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Hosts the checkout URL is allowed to point at (the frontend host is always trusted in mock mode)
TRUSTED_CHECKOUT_HOSTS=rzp.io,razorpay.com

# ---- Salesforce (optional; sync is skipped when unset) ----
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_ORDER_OBJECT=Web_Order__c
SALESFORCE_INBOUND_KEY=change-me-sf-inbound-key
OUTBOX_POLL_MS=5000
OUTBOX_MAX_ATTEMPTS=8

# ---- Accounts ----
JWT_SECRET=change-me-to-a-long-random-string
# Google Cloud OAuth client ID (Web). Leave empty to keep Google sign-in disabled.
GOOGLE_CLIENT_ID=

# ---- Salesforce / Agentforce API ----
# Long random secret. Salesforce sends it in the x-api-key header (stored in the External Credential). Empty = agent API disabled.
AGENT_API_KEY=
# Public base URL for absolute image links returned to Salesforce (public HTTPS site or CDN)
PUBLIC_ASSET_URL=http://localhost:3000

# ---- Production on Render (set in the Render dashboard / render.yaml, not here) ----
# FRONTEND_URL=https://mylapore-web.onrender.com
# CORS_ORIGINS=https://mylapore-web.onrender.com
# PUBLIC_ASSET_URL=https://mylapore-web.onrender.com
